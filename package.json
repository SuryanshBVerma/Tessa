{
  "name": "tessa-qa-monorepo",
  "private": true,
  "description": "Agentic tester for VS Code agent mode and Claude Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuryanshBVerma/Tessa.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "mcp-server",
    "testing/sample-app"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "ci": "npm run format:check && npm run schemas:check && npm run typecheck && npm run lint && npm test && npm run build && npm run plugin:check",
    "sample": "npm run dev -w testing/sample-app",
    "schemas:check": "npm run schemas:types -w mcp-server -- --check",
    "plugin:build": "npm run build -w mcp-server && node mcp-server/scripts/build-plugin.ts",
    "plugin:check": "node mcp-server/scripts/build-plugin.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
