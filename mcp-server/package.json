{
  "name": "tessa-mcp",
  "version": "0.6.0",
  "private": true,
  "description": "MCP server that owns every deterministic or side-effecting Tessa operation",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schemas:types": "node scripts/generate-schema-types.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "json-schema-to-typescript": "16.0.0"
  },
  "bin": {
    "tessa-mcp": "dist/bin.js"
  }
}
