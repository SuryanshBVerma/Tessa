{
  "name": "tessa-mcp",
  "version": "0.0.1",
  "private": true,
  "description": "MCP server that owns every deterministic or side-effecting Tessa operation",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schemas:types": "node scripts/generate-schema-types.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0"
  }
}
