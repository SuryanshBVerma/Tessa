{
  "name": "tessa-sample-app",
  "version": "0.0.1",
  "private": true,
  "description": "Small role-based ticket tracker used as Tessa's test target during development",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "isbot": "5.2.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "scripts": {
    "dev": "docker compose up -d --wait && react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:destroy": "docker compose down --volumes",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts"
  }
}
