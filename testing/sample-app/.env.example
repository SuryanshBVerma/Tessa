# Copy to .env (gitignored) and fill in local-only values. Never reuse a real password.
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
DATABASE_URL=postgres://tessa:<POSTGRES_PASSWORD>@127.0.0.1:5433/tessa_sample
# Long random string used to sign the session cookie.
SESSION_SECRET=
# Shared password for every seeded sample user. Local test value only.
SAMPLE_APP_PASSWORD=
