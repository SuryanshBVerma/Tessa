{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tessa-qa:schema:test-ir:1",
  "title": "TestPlan",
  "description": "Framework-neutral test plan for one story, stored at plans/<story>/tests.json. The report, the selection and every exporter read this; exported code is never written from memory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "story", "tests"],
  "properties": {
    "version": { "const": 1 },
    "story": { "$ref": "#/$defs/story" },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/test" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 80
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "source": {
          "description": "Where the story came from, e.g. a file path or ticket key.",
          "type": "string"
        },
        "acceptance_criteria": {
          "type": "array",
          "items": { "$ref": "#/$defs/criterion" }
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "intent", "persona", "preconditions", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "intent": {
          "description": "One or two sentences on what the test proves.",
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "description": "Acceptance criterion IDs this test covers.",
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "persona": { "$ref": "#/$defs/id" },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "preconditions": { "$ref": "#/$defs/preconditions" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed_profile"],
      "properties": {
        "seed_profile": { "$ref": "#/$defs/id" },
        "feature_flags": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "settings": {
          "description": "User settings the test expects, e.g. theme.",
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "start_path": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "target": {
      "description": "How to find an element. Prefer testid, then role, then label; css is a last resort.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "value"],
          "properties": {
            "strategy": { "enum": ["testid", "label", "text", "placeholder", "css"] },
            "value": { "type": "string", "minLength": 1 },
            "exact": { "type": "boolean", "default": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "role"],
          "properties": {
            "strategy": { "const": "role" },
            "role": {
              "description": "ARIA role, e.g. button, link, textbox.",
              "type": "string",
              "pattern": "^[a-z]+$"
            },
            "name": { "type": "string" },
            "exact": { "type": "boolean", "default": false }
          }
        }
      ]
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["visible", "hidden", "enabled", "disabled", "checked", "unchecked"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "expected"],
          "properties": {
            "kind": {
              "enum": [
                "text-equals",
                "text-contains",
                "value-equals",
                "url-matches",
                "title-equals"
              ]
            },
            "expected": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "expected"],
          "properties": {
            "kind": { "const": "count-equals" },
            "expected": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "description"],
      "properties": {
        "action": {
          "enum": ["navigate", "click", "fill", "select", "check", "uncheck", "wait", "assert"]
        },
        "description": {
          "description": "Plain-language step shown in the report.",
          "type": "string",
          "minLength": 1
        },
        "target": { "$ref": "#/$defs/target" },
        "value": {
          "description": "Path for navigate, text for fill, option for select.",
          "type": "string"
        },
        "value_env": {
          "description": "Environment variable holding the value, for anything that must not be written into the plan.",
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "assertion": { "$ref": "#/$defs/assertion" },
        "timeout_ms": { "type": "integer", "minimum": 0, "maximum": 120000 },
        "expected": {
          "description": "Plain-language expected outcome shown in the report.",
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "navigate" } } },
          "then": { "required": ["value"], "properties": { "value": { "pattern": "^/" } } }
        },
        {
          "if": { "properties": { "action": { "enum": ["click", "check", "uncheck"] } } },
          "then": { "required": ["target"] }
        },
        {
          "if": { "properties": { "action": { "enum": ["fill", "select"] } } },
          "then": {
            "required": ["target"],
            "oneOf": [{ "required": ["value"] }, { "required": ["value_env"] }]
          }
        },
        {
          "if": { "properties": { "action": { "const": "wait" } } },
          "then": { "anyOf": [{ "required": ["target"] }, { "required": ["assertion"] }] }
        },
        {
          "if": { "properties": { "action": { "const": "assert" } } },
          "then": { "required": ["assertion"] }
        },
        {
          "description": "Element assertions need a target; page assertions do not.",
          "if": {
            "required": ["assertion"],
            "properties": {
              "assertion": {
                "properties": { "kind": { "not": { "enum": ["url-matches", "title-equals"] } } }
              }
            }
          },
          "then": { "required": ["target"] }
        }
      ]
    }
  }
}
